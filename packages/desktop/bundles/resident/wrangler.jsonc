{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aelios-resident",
  "main": "{{MAIN}}",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "images": { "binding": "IMAGES" },
  "assets": {
    "directory": "{{ASSETS}}",
    "run_worker_first": ["/messengers/*", "/tg/*", "/web/*", "/mcp/*", "/stickers/*", "/tasks/*", "/runner/*", "/box/*", "/avatar/*", "/r/*", "/manifest.webmanifest"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RESIDENT", "class_name": "Resident" },
      { "name": "BOXES", "class_name": "BoxHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Resident"] },
    { "tag": "v2", "new_sqlite_classes": ["ClaudeBox"] },
    { "tag": "v3", "renamed_classes": [{ "from": "ClaudeBox", "to": "BoxHub" }] }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "RESIDENT", "class_name": "Resident" },
        { "name": "BOXES", "class_name": "BoxHub" }
      ]
    },
    "ai": { "binding": "AI" },
    "browser": { "binding": "BROWSER" },
    "images": { "binding": "IMAGES" }
  },
  "observability": { "enabled": true }
}
